{
  "name": "dsh-antfarm",
  "version": "0.1.0",
  "description": "Declarative multi-agent team workflows for DeepSeek Harness",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/winterhuan/dsh-antfarm.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./runtime": {
      "types": "./lib/types/runtime/index.d.ts",
      "default": "./lib/runtime.js"
    },
    "./tool": {
      "types": "./lib/types/tool/index.d.ts",
      "default": "./lib/tool.js"
    },
    "./commands": {
      "types": "./lib/types/commands/index.d.ts",
      "default": "./lib/commands.js"
    },
    "./studio-host": {
      "types": "./lib/types/studio-host/index.d.ts",
      "default": "./lib/studio-host.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/runtime.js",
    "lib/tool.js",
    "lib/commands.js",
    "lib/studio-host.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/invariant.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "workflows/",
    "README.md",
    "DESIGN.md"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "packageManager": "pnpm@11.7.0",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "clean": "rm -rf lib",
    "build": "tsc -p tsconfig.json --pretty false && tsdown && tsdown --config tsdown.client.config.ts",
    "typecheck": "tsc -p tsconfig.json --pretty false --noEmit",
    "test": "vitest run",
    "check:package": "pnpm run build && publint && npm pack --dry-run && node --input-type=module -e \"await Promise.all(['dsh-antfarm', 'dsh-antfarm/runtime', 'dsh-antfarm/tool', 'dsh-antfarm/commands', 'dsh-antfarm/studio-host', 'dsh-antfarm/invariant'].map(specifier => import(specifier)))\"",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-api-remotes": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.0-rc.6",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
    "@deepseek-ai/dsh-jobs": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-skill": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subagent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-api-remotes": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.0-rc.6",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
    "@deepseek-ai/dsh-jobs": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-loader-smoke": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-skill": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subagent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess-local": "0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "publint": "0.3.21",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "~5.9.3",
    "vitest": "^4.1.8"
  }
}
